server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    # Backend accepts uploads up to 51 MiB; leave multipart/proxy framing headroom.
    client_max_body_size 64m;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_PUBLIC_ORIGINS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_UPLOAD_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_PUBLIC_ORIGINS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_UPLOAD_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_PUBLIC_ORIGINS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_UPLOAD_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    # Actuator remains private to the Compose network.
    location ^~ /api/actuator/ { return 404; }
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
    }
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_PUBLIC_ORIGINS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_UPLOAD_ORIGIN}; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
