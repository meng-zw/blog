# Copy to .env and replace every CHANGE_ME value before production use.
SPRING_DATASOURCE_URL=jdbc:mysql://CHANGE_ME_DATABASE_HOST:3306/blog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=CHANGE_ME_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
BLOG_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_ADMIN_DISPLAY_NAME=小M
PUBLIC_BASE_URL=https://CHANGE_ME.example.com
BLOG_SESSION_COOKIE_SECURE=true
WEB_PORT=8080

# Media storage. Local is the development-safe default and persists in the
# Docker media-data volume. Set BLOG_MEDIA_PROVIDER=r2 only after every R2
# value below has been set through your deployment secret manager.
BLOG_MEDIA_PROVIDER=local
BLOG_MEDIA_LOCAL_DIRECTORY=/app/data/media
BLOG_MEDIA_R2_ACCOUNT_ID=
BLOG_MEDIA_R2_ACCESS_KEY_ID=
BLOG_MEDIA_R2_SECRET_ACCESS_KEY=
BLOG_MEDIA_R2_BUCKET=
BLOG_MEDIA_R2_ENDPOINT=
BLOG_MEDIA_R2_PUBLIC_BASE_URL=
BLOG_MEDIA_R2_LEGACY_BUCKETS=
BLOG_MEDIA_R2_UPLOAD_URL_TTL=10m
# Browser CSP sources injected into public Nginx. In R2 mode these must be
# exact HTTPS origins (no wildcard); keep empty in Local-only deployments.
MEDIA_UPLOAD_ORIGIN=
MEDIA_PUBLIC_ORIGINS=

# Single-instance, in-memory upload-plan limiter. Multi-node deployments must
# replace it with a shared implementation before increasing API replicas.
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_REQUESTS=30
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_WINDOW=1m
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_ENTRIES=10000
