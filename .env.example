# Copy this file to .env for local development. Do not commit .env.
# Spring Boot loads .env as a properties file; Docker Compose reads it directly.

# Local development database password. Used by application-dev.yml.
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD

# Production Docker database connection. These are required only by docker-compose.yml.
# SPRING_DATASOURCE_URL is the JDBC URL, USERNAME is the database user, and PASSWORD is its secret.
SPRING_DATASOURCE_URL=jdbc:mysql://CHANGE_ME_DATABASE_HOST:3306/blog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=CHANGE_ME_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Initial administrator account for first deployment. Do not reuse a public password.
BLOG_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_ADMIN_DISPLAY_NAME=小M

# Public site address used to build stable external URLs. Docker Compose maps this to BLOG_PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://CHANGE_ME.example.com
# Set true only when the public site is served by HTTPS.
BLOG_SESSION_COOKIE_SECURE=true
# Host port exposed by the Docker web service.
WEB_PORT=8080

# Select storage for newly uploaded media: local, r2, or cloudreve.
BLOG_MEDIA_PROVIDER=cloudreve
# Local media directory, used only when BLOG_MEDIA_PROVIDER=local.
BLOG_MEDIA_LOCAL_DIRECTORY=/app/data/media

# Direct R2 mode settings. Leave empty when Cloudreve manages R2 instead.
BLOG_MEDIA_R2_ACCOUNT_ID=
BLOG_MEDIA_R2_ACCESS_KEY_ID=
BLOG_MEDIA_R2_SECRET_ACCESS_KEY=
BLOG_MEDIA_R2_BUCKET=
BLOG_MEDIA_R2_ENDPOINT=
BLOG_MEDIA_R2_PUBLIC_BASE_URL=
BLOG_MEDIA_R2_LEGACY_BUCKETS=
BLOG_MEDIA_R2_UPLOAD_URL_TTL=10m

# Exact browser CSP origins for direct R2 mode; do not use wildcards.
MEDIA_UPLOAD_ORIGIN=
MEDIA_PUBLIC_ORIGINS=

# Enable Cloudreve support. Set true when using Cloudreve now or reading historic Cloudreve assets.
BLOG_MEDIA_CLOUDREVE_ENABLED=true
# Cloudreve server base URL. Use HTTPS in production.
BLOG_MEDIA_CLOUDREVE_BASE_URL=http://CHANGE_ME_CLOUDREVE_HOST:5212
# Optional overrides for nonstandard Cloudreve endpoints; leave blank to use v4 defaults.
BLOG_MEDIA_CLOUDREVE_AUTHORIZATION_URI=
BLOG_MEDIA_CLOUDREVE_TOKEN_URI=
BLOG_MEDIA_CLOUDREVE_REFRESH_URI=
BLOG_MEDIA_CLOUDREVE_USERINFO_URI=
# Must exactly match the redirect URI registered in the Cloudreve OAuth application.
BLOG_MEDIA_CLOUDREVE_REDIRECT_URI=http://localhost:8081/api/admin/media/cloudreve/callback
# Cloudreve v4 API and upload-callback path prefixes.
BLOG_MEDIA_CLOUDREVE_API_BASE_PATH=/api/v4
BLOG_MEDIA_CLOUDREVE_UPLOAD_CALLBACK_BASE_PATH=/api/v4/callback
# OAuth application identifier. It may be shared publicly only if the Cloudreve policy permits it.
BLOG_MEDIA_CLOUDREVE_CLIENT_ID=CHANGE_ME_OAUTH_CLIENT_ID
# OAuth application secret. Keep it private.
BLOG_MEDIA_CLOUDREVE_CLIENT_SECRET=CHANGE_ME_OAUTH_CLIENT_SECRET
# String ID returned by the authenticated user's /api/v4/user/setting/policies endpoint.
BLOG_MEDIA_CLOUDREVE_POLICY_ID=CHANGE_ME_CLOUDREVE_POLICY_ID
# Cloudreve directory reserved for the blog.
BLOG_MEDIA_CLOUDREVE_ROOT_PATH=/blog
# Base64 32-byte AES key that encrypts locally stored OAuth tokens. Never reuse the Client Secret.
BLOG_MEDIA_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
# Development-only permission for a trusted private HTTP Cloudreve endpoint. Keep false in production.
BLOG_MEDIA_CLOUDREVE_ALLOW_TRUSTED_INTERNAL_HTTP=false
# Direct-upload timeouts.
BLOG_MEDIA_CLOUDREVE_CONNECT_TIMEOUT=5s
BLOG_MEDIA_CLOUDREVE_REQUEST_TIMEOUT=30s
# Exact R2 origins returned by Cloudreve. Index 0 is the account endpoint; index 1 is the virtual-hosted bucket endpoint.
BLOG_MEDIA_CLOUDREVE_PROVIDERORIGINS_0=https://CHANGE_ME_R2_ACCOUNT.r2.cloudflarestorage.com
BLOG_MEDIA_CLOUDREVE_PROVIDERORIGINS_1=https://CHANGE_ME_BUCKET.CHANGE_ME_R2_ACCOUNT.r2.cloudflarestorage.com

# Single-instance media upload-plan rate limiter.
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_REQUESTS=30
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_WINDOW=1m
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_ENTRIES=10000
