# Copy to .env and replace every CHANGE_ME value before production use.
SPRING_DATASOURCE_URL=jdbc:mysql://CHANGE_ME_DATABASE_HOST:3306/blog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=CHANGE_ME_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
BLOG_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_ADMIN_DISPLAY_NAME=小M
PUBLIC_BASE_URL=https://CHANGE_ME.example.com
BLOG_SESSION_COOKIE_SECURE=true
WEB_PORT=8080

# Media storage. Local is the development-safe default and persists in the
# Docker media-data volume. Set BLOG_MEDIA_PROVIDER=r2 only after every R2
# value below has been set through your deployment secret manager.
BLOG_MEDIA_PROVIDER=local
BLOG_MEDIA_LOCAL_DIRECTORY=/app/data/media
BLOG_MEDIA_R2_ACCOUNT_ID=
BLOG_MEDIA_R2_ACCESS_KEY_ID=
BLOG_MEDIA_R2_SECRET_ACCESS_KEY=
BLOG_MEDIA_R2_BUCKET=
BLOG_MEDIA_R2_ENDPOINT=
BLOG_MEDIA_R2_PUBLIC_BASE_URL=
BLOG_MEDIA_R2_LEGACY_BUCKETS=
BLOG_MEDIA_R2_UPLOAD_URL_TTL=10m
# Browser CSP sources injected into public Nginx. In R2 mode these must be
# exact HTTPS origins (no wildcard); keep empty in Local-only deployments.
MEDIA_UPLOAD_ORIGIN=
MEDIA_PUBLIC_ORIGINS=

# Cloudreve v4 media storage. This integration is API-only; place Client ID,
# Client Secret and token encryption material in the host secret manager, not
# in Git, frontend settings, Nginx, logs, screenshots, or CI output. Local
# remains the default until provider=cloudreve is explicitly selected.
# See docs/cloudreve-media.md before enabling this block.
BLOG_MEDIA_CLOUDREVE_ENABLED=false
BLOG_MEDIA_CLOUDREVE_BASE_URL=
# Optional independent endpoint overrides. Leave blank to derive the standard
# Cloudreve v4 endpoints from BASE_URL; use only absolute HTTPS URLs in prod.
BLOG_MEDIA_CLOUDREVE_AUTHORIZATION_URI=
BLOG_MEDIA_CLOUDREVE_TOKEN_URI=
BLOG_MEDIA_CLOUDREVE_REFRESH_URI=
BLOG_MEDIA_CLOUDREVE_USERINFO_URI=
# Register this exact callback URI in the Cloudreve OAuth application.
BLOG_MEDIA_CLOUDREVE_REDIRECT_URI=
# Both paths are appended to BASE_URL without dropping any reverse-proxy path
# prefix. Override only when this Cloudreve instance routes v4 API/callbacks
# differently; paths must be absolute and contain no query, fragment or `..`.
BLOG_MEDIA_CLOUDREVE_API_BASE_PATH=/api/v4
BLOG_MEDIA_CLOUDREVE_UPLOAD_CALLBACK_BASE_PATH=/api/v4/callback
BLOG_MEDIA_CLOUDREVE_CLIENT_ID=
BLOG_MEDIA_CLOUDREVE_CLIENT_SECRET=
BLOG_MEDIA_CLOUDREVE_POLICY_ID=
BLOG_MEDIA_CLOUDREVE_ROOT_PATH=/blog
# A distinct base64-encoded random 32-byte AES key; never reuse Client Secret.
BLOG_MEDIA_TOKEN_ENCRYPTION_KEY=
# Development-only opt-in for a trusted, private HTTP test network. Keep false
# in production; public URLs, OAuth endpoints and callback must use HTTPS.
BLOG_MEDIA_CLOUDREVE_ALLOW_TRUSTED_INTERNAL_HTTP=false
BLOG_MEDIA_CLOUDREVE_CONNECT_TIMEOUT=5s
BLOG_MEDIA_CLOUDREVE_REQUEST_TIMEOUT=30s

# Single-instance, in-memory upload-plan limiter. Multi-node deployments must
# replace it with a shared implementation before increasing API replicas.
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_REQUESTS=30
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_WINDOW=1m
BLOG_MEDIA_UPLOAD_PLAN_RATE_LIMIT_MAX_ENTRIES=10000
