# Copy to .env and replace every CHANGE_ME value before production use.
SPRING_DATASOURCE_URL=jdbc:mysql://CHANGE_ME_DATABASE_HOST:3306/blog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=CHANGE_ME_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
BLOG_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_ADMIN_DISPLAY_NAME=小M
PUBLIC_BASE_URL=https://CHANGE_ME.example.com
BLOG_SESSION_COOKIE_SECURE=true
WEB_PORT=8080
