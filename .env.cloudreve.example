# Copy this file to .env when deploying with Cloudreve. Do not commit .env.
# Replace every CHANGE_ME_* value before running docker compose up -d.

# Built images in Alibaba Cloud Container Registry.
BLOG_IMAGE_REPOSITORY=crpi-p853hywlwywfu2no.cn-hangzhou.personal.cr.aliyuncs.com/mengzw/my-storehouse
BLOG_IMAGE_TAG=latest

# Docker Compose MySQL service and initial blog administrator.
MYSQL_DATABASE=blog
MYSQL_USER=blog_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
BLOG_ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_ADMIN_DISPLAY_NAME=小M

# Public HTTPS address of this blog. It must match the Cloudreve OAuth redirect URI below.
PUBLIC_BASE_URL=https://CHANGE_ME_BLOG_DOMAIN
BLOG_SESSION_COOKIE_SECURE=true
WEB_PORT=8080

# Cloudreve v4 storage. These values are injected only into the API container.
BLOG_MEDIA_PROVIDER=cloudreve
BLOG_MEDIA_CLOUDREVE_ENABLED=true
BLOG_MEDIA_CLOUDREVE_BASE_URL=https://CHANGE_ME_CLOUDREVE_DOMAIN
BLOG_MEDIA_CLOUDREVE_REDIRECT_URI=https://CHANGE_ME_BLOG_DOMAIN/api/admin/media/cloudreve/callback
BLOG_MEDIA_CLOUDREVE_CLIENT_ID=CHANGE_ME_OAUTH_CLIENT_ID
BLOG_MEDIA_CLOUDREVE_CLIENT_SECRET=CHANGE_ME_OAUTH_CLIENT_SECRET
# Use the string id from /api/v4/user/setting/policies, not a numeric admin-policy id.
BLOG_MEDIA_CLOUDREVE_POLICY_ID=CHANGE_ME_POLICY_ID
BLOG_MEDIA_CLOUDREVE_ROOT_PATH=/blog
# Base64 encoding of a distinct 32-byte AES key; keep it with the database backup.
BLOG_MEDIA_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
BLOG_MEDIA_CLOUDREVE_ALLOW_TRUSTED_INTERNAL_HTTP=false

# Keep defaults unless your Cloudreve instance uses nonstandard endpoint paths.
BLOG_MEDIA_CLOUDREVE_API_BASE_PATH=/api/v4
BLOG_MEDIA_CLOUDREVE_UPLOAD_CALLBACK_BASE_PATH=/api/v4/callback
BLOG_MEDIA_CLOUDREVE_CONNECT_TIMEOUT=5s
BLOG_MEDIA_CLOUDREVE_REQUEST_TIMEOUT=30s

# Exact origins returned by Cloudreve for its underlying object-storage uploads.
BLOG_MEDIA_CLOUDREVE_PROVIDERORIGINS_0=https://CHANGE_ME_R2_ACCOUNT.r2.cloudflarestorage.com
BLOG_MEDIA_CLOUDREVE_PROVIDERORIGINS_1=https://CHANGE_ME_BUCKET.CHANGE_ME_R2_ACCOUNT.r2.cloudflarestorage.com

# Optional endpoint overrides; leave blank for standard Cloudreve v4 endpoints.
BLOG_MEDIA_CLOUDREVE_AUTHORIZATION_URI=
BLOG_MEDIA_CLOUDREVE_TOKEN_URI=
BLOG_MEDIA_CLOUDREVE_REFRESH_URI=
BLOG_MEDIA_CLOUDREVE_USERINFO_URI=

# R2 variables are unused by Cloudreve mode. The browser continues to use the blog's stable /api/media/assets/* URLs.
MEDIA_UPLOAD_ORIGIN=
MEDIA_PUBLIC_ORIGINS=
